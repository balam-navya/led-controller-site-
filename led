<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ESP32 LED Switch</title><style>
*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f1f5ef;color:#23352b;font:16px system-ui,Segoe UI,sans-serif}.box{width:min(430px,calc(100% - 32px));padding:28px;background:#fff;border:1px solid #dfe7dc;border-radius:20px;box-shadow:0 14px 40px #203c2512}h1{font-size:26px;margin:0 0 6px}p{color:#647268;margin:0 0 20px;font-size:14px}label{display:block;font-size:14px;font-weight:700;margin-bottom:7px}input{width:100%;padding:12px;border:1px solid #cfd9cc;border-radius:10px;font:inherit;margin-bottom:10px}.status{padding:10px 12px;border-radius:10px;background:#eef1ec;color:#647268;font-size:13px;margin:4px 0 14px}.status.ok{background:#e8f4ea;color:#287344}.status.bad{background:#fbefeb;color:#a44032}.buttons{display:grid;grid-template-columns:1fr 1fr;gap:10px}button{padding:13px;border:0;border-radius:10px;font:700 15px system-ui;cursor:pointer}.test{width:100%;background:#e9eee7;color:#26382d;margin:8px 0 14px}.on{background:#2f704c;color:white}.off{background:#e9eee7;color:#26382d}button:disabled{opacity:.55;cursor:wait}.hint{font-size:12px;color:#78857c;margin-top:14px}</style></head><body><main class="box"><h1>ESP32 LED</h1><p>Enter your ESP32 IP address. Your computer and ESP32 should use the same Wi-Fi.</p><label for="ip">ESP32 IP address</label><input id="ip" placeholder="192.168.1.50" autocomplete="url" inputmode="url"><button id="test" class="test">Test connection</button><div id="status" class="status" role="status" aria-live="polite">Not connected yet.</div><div class="buttons"><button id="on" class="on">Turn LED ON</button><button id="off" class="off">Turn LED OFF</button></div><div class="hint">Connection is confirmed when the ESP32 replies. If the test fails, check the IP, Wi-Fi, and that the ESP32 sketch is running.</div></main><script>
const ipInput=document.querySelector("#ip"),statusBox=document.querySelector("#status"),controls=[document.querySelector("#test"),document.querySelector("#on"),document.querySelector("#off")];function show(text,kind=""){statusBox.textContent=text;statusBox.className="status "+kind}function getIp(){const ip=ipInput.value.trim();if(!/^[a-zA-Z0-9.-]+$/.test(ip)){show("Enter the ESP32 IP address, for example 192.168.1.50.","bad");ipInput.focus();return null}return ip}async function request(path){const ip=getIp();if(!ip)return;controls.forEach(b=>b.disabled=true);show("Connecting to ESP32…");try{const response=await fetch("http://"+ip+path,{cache:"no-store",signal:AbortSignal.timeout(5000)});if(!response.ok)throw new Error();const reply=(await response.text()).trim();if(path==="/status")show("Connected successfully · "+ip,"ok");else show("Connected successfully · "+(reply||"LED command received"),"ok")}catch(e){show("Not connected · Check the IP, Wi-Fi, and ESP32 sketch.","bad")}finally{controls.forEach(b=>b.disabled=false)}}document.querySelector("#test").onclick=()=>request("/status");document.querySelector("#on").onclick=()=>request("/led/on");document.querySelector("#off").onclick=()=>request("/led/off");ipInput.addEventListener("input",()=>show("IP changed · test the connection again."));
</script></body></html>
